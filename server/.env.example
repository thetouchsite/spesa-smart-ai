# ─── Obbligatorie ──────────────────────────────────────────────────────
# Chiave Google AI Studio: https://aistudio.google.com/apikey
# Costo Gemini 3 Flash: 0,25 $ / 1M token in ingresso, 1,50 $ / 1M in uscita.
# Prezzo introduttivo: verificare dopo il 31/12/2026.
GOOGLE_GENERATIVE_AI_API_KEY=

# Stringa di connessione MongoDB. Su Railway: aggiungi il servizio MongoDB e
# usa la variabile ${{MongoDB.MONGO_URL}} invece di incollare l'URI a mano.
MONGODB_URI=
MONGODB_DB=spesa_smart

# Firma dei token di sessione. Almeno 32 caratteri casuali.
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarla invalida tutte le sessioni attive.
AUTH_SECRET=

# ─── Facoltative ───────────────────────────────────────────────────────
# Modello Gemini. Lasciare vuoto per il default (gemini-3-flash-preview).
GEMINI_MODEL=

# Fornitore di ricerca per le ricette: "ddg" (gratis, attualmente bloccato
# da anti-bot) oppure "brave" (a pagamento, ~10-30 €/mese).
# Passare a Brave = cambiare queste due righe, nessuna modifica al codice.
SEARCH_PROVIDER=ddg
BRAVE_SEARCH_API_KEY=

# Origini ammesse per le chiamate da browser, separate da virgola.
# Vuoto = tutte (va bene in sviluppo). In produzione impostalo, altrimenti
# qualunque sito può usare questo backend, e quindi la nostra chiave Gemini.
# Le app native non inviano Origin e non sono toccate da questa impostazione.
ALLOWED_ORIGINS=

# Porta di ascolto. Su Railway viene impostata automaticamente: non toccarla.
PORT=3000
