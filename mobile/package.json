{
  "name": "spesa-smart-mobile",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "verify": "node ../node_modules/esbuild/bin/esbuild scripts/verify-flow.ts --bundle --platform=node --format=esm --outfile=scripts/verify-flow.mjs --alias:@=./src --log-level=error && node scripts/verify-flow.mjs",
    "prebuild": "expo prebuild --platform android",
    "apk": "node scripts/apk.mjs",
    "apk:apri": "explorer android\\app\\build\\outputs\\apk\\release",
    "demo": "node scripts/pubblica-demo.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.15",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.2",
    "react": "^19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.1",
    "typescript": "^5.8.3"
  }
}
