{
  "expo": {
    "name": "Spesa Smart",
    "slug": "spesa-smart",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spesasmart",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00723B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spesasmart.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Serve per trovare i supermercati vicini a te e stimare i prezzi della tua zona.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spesasmart.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00723B"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Serve per trovare i supermercati vicini a te e stimare i prezzi della tua zona."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "http://localhost:3000"
    },
    "icon": "./assets/icon.png",
    "description": "Organizza la spesa della settimana dentro il tuo budget: menù, ricette e lista della spesa.",
    "primaryColor": "#00723B"
  }
}
