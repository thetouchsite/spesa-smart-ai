{
  "expo": {
    "name": "MealMint",
    "slug": "spesa-smart",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spesasmart",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spesasmart.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Serve per trovare i supermercati vicini a te e stimare i prezzi della tua zona.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spesasmart.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Serve per trovare i supermercati vicini a te e stimare i prezzi della tua zona."
        }
      ],
      "expo-asset",
      "./plugins/percorsi-lunghi-windows"
    ],
    "extra": {
      "apiUrl": "http://localhost:3000",
      "router": {},
      "eas": {
        "projectId": "76517650-a7f7-45b9-ac9a-ee398ec35774"
      }
    },
    "icon": "./assets/icon.png",
    "description": "Organizza la spesa della settimana dentro il tuo budget: menù, ricette e lista della spesa.",
    "primaryColor": "#00723B",
    "owner": "marettax",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/76517650-a7f7-45b9-ac9a-ee398ec35774"
    }
  }
}
