expo-env.d.ts
# `verify-flow.mjs` lo PRODUCE esbuild da `verify-flow.ts` a ogni `npm run
# verify`: e' un file generato e non va in git. La regola pero' era
# `scripts/*.mjs`, che prendeva dentro anche gli script scritti a mano —
# `apk.mjs`, `pubblica-demo.mjs`, `build-ingredient-map.mjs` sono rimasti
# fuori dal repo senza che nessuno se ne accorgesse, perche' `git add` di un
# file ignorato non e' un errore rumoroso.
scripts/verify-flow.mjs

# Le cartelle native le GENERA `expo prebuild`, non si scrivono a mano.
#
# Tenerle fuori da git e' una scelta, non una dimenticanza: finche' non ci
# sono, `app.json` e' l'unica verita' sulla configurazione dell'app — nome,
# icona, permessi, package — e ogni build la rilegge. Dal momento in cui
# `android/` viene committato diventa lui la verita': cambiare `app.json` non
# ha piu' effetto finche' qualcuno non rifa' prebuild, e la differenza non la
# segnala nessuno.
#
# Si committano il giorno che serve scriverci dentro codice nativo a mano.
android/
ios/

# Il pacchetto per il browser lo produce `expo export`: si rigenera, non si versiona.
dist-web/

# File di scorta e di scarto: non devono mai finire nel repository.
.env.locale-backup
*.prima
